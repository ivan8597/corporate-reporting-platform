# Локальный запуск по умолчанию использует SQLite
DB_TYPE=sqlite
DB_NAME=data/sales.db

# Отчётность
TEMPLATE_PATH=templates/report_template.xlsx
OUTPUT_DIR=data/reports

# Логирование
LOG_LEVEL=INFO

# Эти параметры нужны только при DB_TYPE=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corporate_reporting
POSTGRES_USER=report_user
POSTGRES_PASSWORD=report_password
